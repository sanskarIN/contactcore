root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,axaml,xml}]
indent_size = 2

[*.cs]
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_diagnostic.IDE0005.severity = warning

# Test methods intentionally use descriptive underscore-separated names, and test-only
# helper expressions favor readability over production micro-optimization diagnostics.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.IDE0005.severity = none

# These two summary properties are consumed through Avalonia instance binding. Making
# them static would remove them from the binding surface even though their values are
# currently constant. Keep the exception on the one binding view-model that needs it.
[src/ContactCore.UI/MainViewModel.cs]
dotnet_diagnostic.CA1822.severity = none

# This desktop view-model is itself an Avalonia binding surface. Its constant About/
# support/project projections must remain instance properties. The contact wrapper also
# intentionally exposes the primary-constructor object as Model and as binding projections,
# and its fixed yyyy-MM-dd birthday text is an interchange/UI contract. Keep these legacy
# compatibility exceptions isolated to this single file rather than weakening analysis
# for any other production source.
[src/ContactCore.Desktop/ViewModels.cs]
dotnet_diagnostic.CA1822.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CS9124.severity = none
