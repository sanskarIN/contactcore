<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ContactCore.Desktop.MainWindow"
        Title="ContactCore" Width="1180" Height="760" MinWidth="850" MinHeight="560"
        x:CompileBindings="False">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Classes="TopBar" Grid.Row="0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Classes="Logo"><TextBlock Text="CC" FontWeight="Bold" /></Border>
          <StackPanel>
            <TextBlock Text="ContactCore" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Private, offline-first contacts" Classes="Muted" FontSize="11" />
          </StackPanel>
        </StackPanel>
        <TextBox x:Name="SearchBox" Grid.Column="1" Watermark="Search names, phones, or emails…" Text="{Binding SearchText, Mode=TwoWay}" MaxWidth="520" HorizontalAlignment="Stretch" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Content="New contact" Command="{Binding NewContactCommand}" Classes="Primary" />
          <Button Content="Settings" Command="{Binding ShowSettingsCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,360,*">
      <Border Classes="Sidebar" Grid.Column="0">
        <StackPanel Spacing="8">
          <TextBlock Text="Browse" Classes="SectionLabel" />
          <ToggleButton Content="All contacts" IsChecked="{Binding ShowAll}" Command="{Binding ShowAllCommand}" />
          <ToggleButton Content="Favorites" IsChecked="{Binding FavoritesOnly}" Command="{Binding FavoritesCommand}" />
          <ToggleButton Content="Archived" IsChecked="{Binding ArchivedOnly}" Command="{Binding ArchivedCommand}" />
          <Separator Margin="0,12" />
          <TextBlock Text="Alphabet" Classes="SectionLabel" />
          <ItemsControl ItemsSource="{Binding Alphabet}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding $parent[Window].DataContext.FilterLetterCommand}" CommandParameter="{Binding}" Classes="Letter" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Separator Margin="0,12" />
          <Button Content="Import / Export" Command="{Binding ShowDataToolsCommand}" />
          <Button Content="Find duplicates" Command="{Binding FindDuplicatesCommand}" />
          <TextBlock Margin="0,16,0,0" Text="Made by the Sanskar" Classes="Muted" FontSize="11" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="ListPane">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Text="{Binding ListHeading}" FontWeight="SemiBold" FontSize="18" />
            <TextBlock Grid.Column="1" Text="{Binding ResultCountText}" Classes="Muted" VerticalAlignment="Center" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="48,*,Auto" Margin="2,7">
                  <Border Width="40" Height="40" CornerRadius="20" Classes="Avatar"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border>
                  <StackPanel Grid.Column="1" Margin="10,0">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Classes="Muted" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="★" IsVisible="{Binding IsFavorite}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="DetailPane">
        <Grid>
          <ScrollViewer IsVisible="{Binding IsEditorVisible}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="14">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="{Binding EditorTitle}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Content="Save" Command="{Binding SaveCommand}" Classes="Primary" />
                  <Button Content="Delete" Command="{Binding DeleteCommand}" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel><TextBlock Text="Given name" Classes="FieldLabel"/><TextBox Text="{Binding Draft.GivenName, Mode=TwoWay}" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Family name" Classes="FieldLabel"/><TextBox Text="{Binding Draft.FamilyName, Mode=TwoWay}" /></StackPanel>
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                <StackPanel><TextBlock Text="Nickname" Classes="FieldLabel"/><TextBox Text="{Binding Draft.Nickname, Mode=TwoWay}" /></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Birthday (yyyy-MM-dd)" Classes="FieldLabel"/><TextBox Text="{Binding Draft.BirthdayText, Mode=TwoWay}" /></StackPanel>
              </Grid>
              <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel><TextBlock Text="Phone" Classes="FieldLabel"/><TextBox Text="{Binding Draft.Phone, Mode=TwoWay}" /></StackPanel>
                <CheckBox Grid.Column="1" Content="Favorite" IsChecked="{Binding Draft.IsFavorite, Mode=TwoWay}" VerticalAlignment="Bottom" Margin="0,0,0,9" />
              </Grid>
              <StackPanel Grid.Row="4"><TextBlock Text="Email" Classes="FieldLabel"/><TextBox Text="{Binding Draft.Email, Mode=TwoWay}" /></StackPanel>
              <StackPanel Grid.Row="5"><TextBlock Text="Notes" Classes="FieldLabel"/><TextBox Text="{Binding Draft.Notes, Mode=TwoWay}" AcceptsReturn="True" MinHeight="120" TextWrapping="Wrap" /></StackPanel>
              <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" Classes="Status" TextWrapping="Wrap" />
            </Grid>
          </ScrollViewer>

          <ScrollViewer IsVisible="{Binding IsSettingsVisible}">
            <StackPanel Spacing="18" MaxWidth="720" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" />
                  <TextBlock Text="Appearance, accessibility, local data, privacy, and About" Classes="Muted" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Close" Command="{Binding CancelEditCommand}" VerticalAlignment="Top" />
              </Grid>

              <Border Classes="SettingsCard">
                <StackPanel Spacing="10">
                  <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Theme" Classes="FieldLabel" />
                  <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" MinWidth="180" HorizontalAlignment="Left" />
                  <CheckBox Content="Reduce nonessential motion" IsChecked="{Binding ReducedMotion, Mode=TwoWay}" />
                  <TextBlock Text="Theme changes are saved locally. System follows your operating-system preference." Classes="Muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Spacing="8">
                  <TextBlock Text="Data &amp; privacy" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="ContactCore keeps contact data on this device unless you explicitly export or back it up." TextWrapping="Wrap" />
                  <TextBlock Text="Local data directory" Classes="FieldLabel" />
                  <TextBlock Text="{Binding DataDirectory}" FontFamily="Monospace" TextWrapping="Wrap" />
                  <TextBlock Text="Backups and exported files can contain personal information. Store them in a location you trust." Classes="Muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Spacing="8">
                  <TextBlock Text="About" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding AboutSummary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding SupportSummary}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ProjectSummary}" TextWrapping="Wrap" />
                  <TextBlock Text="Open source • no mandatory account • no telemetry dependency" Classes="Muted" TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Classes="Primary" />
                <Button Content="Cancel" Command="{Binding CancelEditCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer IsVisible="{Binding IsDataToolsVisible}">
            <StackPanel Spacing="18" MaxWidth="720" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Data tools" FontSize="26" FontWeight="SemiBold" />
                  <TextBlock Text="Portable imports, exports, and verified local backups" Classes="Muted" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Close" Command="{Binding CancelEditCommand}" VerticalAlignment="Top" />
              </Grid>

              <Border Classes="SettingsCard">
                <StackPanel Spacing="10">
                  <TextBlock Text="Import" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Import CSV or vCard files. The complete file is validated before a single transaction writes any contacts, so a failed import does not leave a partial batch." TextWrapping="Wrap" />
                  <Button Content="Choose CSV or vCard…" Command="{Binding ImportContactsCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Spacing="10">
                  <TextBlock Text="Export" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Exports include archived contacts and are created only when you choose a destination." TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Export CSV…" Command="{Binding ExportCsvCommand}" />
                    <Button Content="Export vCard…" Command="{Binding ExportVCardCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Classes="SettingsCard">
                <StackPanel Spacing="10">
                  <TextBlock Text="Backup" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Create a SQLite-native snapshot and run an integrity check before it is reported as successful." TextWrapping="Wrap" />
                  <TextBlock Text="Backup directory" Classes="FieldLabel" />
                  <TextBlock Text="{Binding BackupDirectory}" FontFamily="Monospace" TextWrapping="Wrap" />
                  <Button Content="Create verified backup" Command="{Binding CreateBackupCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <TextBlock Text="{Binding StatusMessage}" Classes="Status" TextWrapping="Wrap" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="StatusBar">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding FooterText}" Classes="Muted" />
        <TextBlock Grid.Column="1" Text="Local data • no mandatory cloud" Classes="Muted" />
      </Grid>
    </Border>
  </Grid>
</Window>
