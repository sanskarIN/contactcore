<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ContactCore.Desktop.ConfirmDialog"
        Title="Confirm"
        Width="440" Height="210"
        MinWidth="360" MinHeight="190"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        x:CompileBindings="False">
  <Grid RowDefinitions="*,Auto" Margin="22" RowSpacing="18">
    <StackPanel Spacing="10">
      <TextBlock Text="Confirm action" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancelClick" MinWidth="90" />
      <Button Content="Continue" Click="OnConfirmClick" Classes="Primary" MinWidth="90" />
    </StackPanel>
  </Grid>
</Window>
