<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Window"><Setter Property="FontSize" Value="14" /></Style>
  <Style Selector="Border.TopBar"><Setter Property="Padding" Value="20,14"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style Selector="Border.Sidebar"><Setter Property="Padding" Value="16"/><Setter Property="Background" Value="{DynamicResource ThemeControlLowBrush}"/></Style>
  <Style Selector="Border.ListPane"><Setter Property="Padding" Value="16"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}"/><Setter Property="BorderThickness" Value="0,0,1,0"/></Style>
  <Style Selector="Border.DetailPane"><Setter Property="Padding" Value="28"/></Style>
  <Style Selector="Border.StatusBar"><Setter Property="Padding" Value="14,8"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}"/><Setter Property="BorderThickness" Value="0,1,0,0"/></Style>
  <Style Selector="Border.Logo"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Border.Logo TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="Border.Avatar"><Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}"/></Style>
  <Style Selector="Border.Card"><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="10"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Border.Overlay"><Setter Property="Background" Value="#99000000"/><Setter Property="Padding" Value="24"/></Style>
  <Style Selector="Border.DialogCard"><Setter Property="Padding" Value="26"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="TextBlock.Muted"><Setter Property="Opacity" Value="0.68"/></Style>
  <Style Selector="TextBlock.SectionLabel"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Opacity" Value="0.76"/><Setter Property="Margin" Value="0,4,0,2"/></Style>
  <Style Selector="TextBlock.FieldLabel"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style Selector="TextBlock.Status"><Setter Property="Opacity" Value="0.9"/></Style>
  <Style Selector="Button.Primary"><Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style Selector="Button.Danger"><Setter Property="Foreground" Value="#D13438"/></Style>
  <Style Selector="Button.Letter"><Setter Property="MinWidth" Value="34"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="2"/></Style>
  <Style Selector="Button:focus, TextBox:focus, ToggleButton:focus, ListBox:focus, ComboBox:focus"><Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/><Setter Property="BorderThickness" Value="2"/></Style>
</Styles>
